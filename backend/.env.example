# Configuration and Environment Variables for Colombian Language Academy

# LLM Provider Configuration ('openai' or 'gemini')
LLM_PROVIDER=openai

# OpenAI API Credentials
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Google Gemini API Credentials
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_CHAT_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Database & Storage
DATABASE_URL=sqlite+aiosqlite:///./data/academy.db
CHROMA_PERSIST_DIR=./data/chroma_db

# Telegram Bot (Optional for web-only usage)
TELEGRAM_BOT_NAME=Vanguard_academy_bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Administrator Security
ADMIN_DEFAULT_USER=admin
ADMIN_DEFAULT_PASSWORD=your_secure_admin_password_here
ADMIN_FORCE_PASSWORD_SYNC=false
ADMIN_API_KEY=admin
JWT_SECRET=your_jwt_secret_key_here

# Server & Network Configuration
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]
DEBUG=false
