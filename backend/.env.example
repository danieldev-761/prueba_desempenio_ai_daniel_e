# ==============================================================================
# Environment Configuration Template for Colombian Language Academy Backend
# ==============================================================================

# Server Network Settings
PORT=8000
HOST=0.0.0.0
DEBUG=False

# Primary LLM Provider: 'gemini' (Primary Default) or 'openai'
LLM_PROVIDER=gemini

# Google Gemini Credentials (Primary Provider)
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# OpenAI Credentials (Alternative Provider)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Vector Store & Semantic Caching
CHROMA_PERSIST_DIR=./data/chroma_db
ACADEMY_COLLECTION_NAME=academy_docs
CACHE_COLLECTION_NAME=semantic_cache
CACHE_SIMILARITY_THRESHOLD=0.82
RETRIEVAL_SIMILARITY_THRESHOLD=0.45

# Database Persistence
DATABASE_URL=sqlite+aiosqlite:///./data/academy.db

# Security & Staff Dashboard
ADMIN_API_KEY=admin123

# Telegram Bot Integration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Cross-Origin Resource Sharing
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000", "*"]
